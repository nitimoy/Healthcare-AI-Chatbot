# ─────────────────────────────────────────────────────────────────────────────
# Healthcare AI Chatbot — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# .env is listed in .gitignore and will NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (NVIDIA NIM API — OpenAI-compatible) ─────────────────────────────────
NVIDIA_API_KEY=your-nvidia-api-key-here
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=meta/llama-3.1-8b-instruct

# ── Generation parameters ────────────────────────────────────────────────────
TEMPERATURE=0.3
MAX_OUTPUT_TOKENS=1024

# ── Retrieval ─────────────────────────────────────────────────────────────────
TOP_K=5

# ── Embedding model (sentence-transformers, used by ChromaDB) ────────────────
EMBEDDING_MODEL=BAAI/bge-m3

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_PATH=data/chroma
COLLECTION_NAME=medical_knowledge_base

# ── Data paths ────────────────────────────────────────────────────────────────
CHUNKS_PATH=data/processed/chunked_documents.json
EMBED_BATCH_SIZE=64

# Secrets — never commit
.env

# Python / Bytecode artifacts
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
dist/
build/

# Virtual Environment
.venv/
venv/
env/

# Data & Vector Store — Generated automatically by pipeline from XML
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/chroma/*
!data/chroma/.gitkeep

# Explicitly track canonical XML dataset source file for first run
!mplus_topics_2026-07-28.xml

# System & IDE files
.DS_Store
.idea/
.vscode/
*.swp
*.tmp
